{
  "info": {
    "name": "Setu Payment Events Service",
    "description": "Complete Postman collection for the Setu Payment Events API.\n\nSet the `base_url` variable to your server address before running.\nDefault: http://localhost:8000",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "transaction_id",
      "value": "2f86e94c-239c-4302-9874-75f28e3474ee",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/health",
            "description": "Verify the service is running."
          }
        }
      ]
    },
    {
      "name": "Events",
      "item": [
        {
          "name": "Ingest Single Event - payment_initiated",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/events",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event_id\": \"test-evt-001\",\n  \"event_type\": \"payment_initiated\",\n  \"transaction_id\": \"test-txn-001\",\n  \"merchant_id\": \"merchant_1\",\n  \"merchant_name\": \"QuickMart\",\n  \"amount\": 9999.99,\n  \"currency\": \"INR\",\n  \"timestamp\": \"2026-03-01T10:00:00+00:00\"\n}"
            },
            "description": "Ingest a payment_initiated event. Run this first to create the transaction."
          }
        },
        {
          "name": "Ingest Single Event - payment_processed",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/events",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event_id\": \"test-evt-002\",\n  \"event_type\": \"payment_processed\",\n  \"transaction_id\": \"test-txn-001\",\n  \"merchant_id\": \"merchant_1\",\n  \"merchant_name\": \"QuickMart\",\n  \"amount\": 9999.99,\n  \"currency\": \"INR\",\n  \"timestamp\": \"2026-03-01T10:05:00+00:00\"\n}"
            }
          }
        },
        {
          "name": "Ingest Single Event - settled",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/events",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event_id\": \"test-evt-003\",\n  \"event_type\": \"settled\",\n  \"transaction_id\": \"test-txn-001\",\n  \"merchant_id\": \"merchant_1\",\n  \"merchant_name\": \"QuickMart\",\n  \"amount\": 9999.99,\n  \"currency\": \"INR\",\n  \"timestamp\": \"2026-03-01T10:15:00+00:00\"\n}"
            }
          }
        },
        {
          "name": "Ingest Duplicate Event (Idempotency Test)",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/events",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event_id\": \"test-evt-001\",\n  \"event_type\": \"payment_initiated\",\n  \"transaction_id\": \"test-txn-001\",\n  \"merchant_id\": \"merchant_1\",\n  \"merchant_name\": \"QuickMart\",\n  \"amount\": 9999.99,\n  \"currency\": \"INR\",\n  \"timestamp\": \"2026-03-01T10:00:00+00:00\"\n}"
            },
            "description": "Submitting the same event again should return status=duplicate without corrupting state."
          }
        },
        {
          "name": "Ingest Invalid Event (missing field)",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/events",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event_id\": \"bad-evt-001\",\n  \"transaction_id\": \"test-txn-bad\",\n  \"merchant_id\": \"merchant_1\",\n  \"merchant_name\": \"QuickMart\",\n  \"amount\": 500.00,\n  \"currency\": \"INR\",\n  \"timestamp\": \"2026-03-01T10:00:00+00:00\"\n}"
            },
            "description": "Missing event_type — should return HTTP 422."
          }
        },
        {
          "name": "Bulk Ingest Events",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/events/bulk",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "[\n  {\n    \"event_id\": \"bulk-evt-001\",\n    \"event_type\": \"payment_initiated\",\n    \"transaction_id\": \"bulk-txn-001\",\n    \"merchant_id\": \"merchant_2\",\n    \"merchant_name\": \"FreshBasket\",\n    \"amount\": 5000.00,\n    \"currency\": \"INR\",\n    \"timestamp\": \"2026-03-02T09:00:00+00:00\"\n  },\n  {\n    \"event_id\": \"bulk-evt-002\",\n    \"event_type\": \"payment_initiated\",\n    \"transaction_id\": \"bulk-txn-002\",\n    \"merchant_id\": \"merchant_3\",\n    \"merchant_name\": \"UrbanEats\",\n    \"amount\": 12000.50,\n    \"currency\": \"INR\",\n    \"timestamp\": \"2026-03-02T09:05:00+00:00\"\n  },\n  {\n    \"event_id\": \"bulk-evt-003\",\n    \"event_type\": \"payment_processed\",\n    \"transaction_id\": \"bulk-txn-002\",\n    \"merchant_id\": \"merchant_3\",\n    \"merchant_name\": \"UrbanEats\",\n    \"amount\": 12000.50,\n    \"currency\": \"INR\",\n    \"timestamp\": \"2026-03-02T09:20:00+00:00\"\n  }\n]",
              "description": "Ingest multiple events in one request."
            }
          }
        }
      ]
    },
    {
      "name": "Transactions",
      "item": [
        {
          "name": "List All Transactions",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/transactions",
            "description": "Returns paginated list of all transactions."
          }
        },
        {
          "name": "List Transactions - Filter by Merchant",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/transactions?merchant_id=merchant_1",
              "host": ["{{base_url}}"],
              "path": ["transactions"],
              "query": [{ "key": "merchant_id", "value": "merchant_1" }]
            }
          }
        },
        {
          "name": "List Transactions - Filter by Status",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/transactions?status=settled",
              "host": ["{{base_url}}"],
              "path": ["transactions"],
              "query": [{ "key": "status", "value": "settled" }]
            }
          }
        },
        {
          "name": "List Transactions - Filter by Date Range",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/transactions?date_from=2026-01-01T00:00:00Z&date_to=2026-02-01T00:00:00Z",
              "host": ["{{base_url}}"],
              "path": ["transactions"],
              "query": [
                { "key": "date_from", "value": "2026-01-01T00:00:00Z" },
                { "key": "date_to", "value": "2026-02-01T00:00:00Z" }
              ]
            }
          }
        },
        {
          "name": "List Transactions - Sort by Amount Ascending",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/transactions?sort_by=amount&sort_order=asc&page_size=10",
              "host": ["{{base_url}}"],
              "path": ["transactions"],
              "query": [
                { "key": "sort_by", "value": "amount" },
                { "key": "sort_order", "value": "asc" },
                { "key": "page_size", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "List Transactions - Paginated",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/transactions?page=2&page_size=5",
              "host": ["{{base_url}}"],
              "path": ["transactions"],
              "query": [
                { "key": "page", "value": "2" },
                { "key": "page_size", "value": "5" }
              ]
            }
          }
        },
        {
          "name": "Get Transaction Detail",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/transactions/{{transaction_id}}",
            "description": "Returns full transaction details including event history. Update the transaction_id variable with a real ID from your DB."
          }
        },
        {
          "name": "Get Transaction - Not Found",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/transactions/does-not-exist",
            "description": "Should return HTTP 404."
          }
        }
      ]
    },
    {
      "name": "Reconciliation",
      "item": [
        {
          "name": "Reconciliation Summary - All",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/reconciliation/summary",
            "description": "Returns transaction counts and amounts grouped by merchant, date, and status."
          }
        },
        {
          "name": "Reconciliation Summary - Filter by Merchant",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/reconciliation/summary?merchant_id=merchant_1",
              "host": ["{{base_url}}"],
              "path": ["reconciliation", "summary"],
              "query": [{ "key": "merchant_id", "value": "merchant_1" }]
            }
          }
        },
        {
          "name": "Reconciliation Summary - Filter by Date Range",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/reconciliation/summary?date_from=2026-01-01T00:00:00Z&date_to=2026-01-31T23:59:59Z",
              "host": ["{{base_url}}"],
              "path": ["reconciliation", "summary"],
              "query": [
                { "key": "date_from", "value": "2026-01-01T00:00:00Z" },
                { "key": "date_to", "value": "2026-01-31T23:59:59Z" }
              ]
            }
          }
        },
        {
          "name": "Reconciliation Discrepancies - All",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/reconciliation/discrepancies",
            "description": "Returns all transactions with payment/settlement inconsistencies."
          }
        },
        {
          "name": "Reconciliation Discrepancies - Filter by Merchant",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/reconciliation/discrepancies?merchant_id=merchant_4",
              "host": ["{{base_url}}"],
              "path": ["reconciliation", "discrepancies"],
              "query": [{ "key": "merchant_id", "value": "merchant_4" }]
            }
          }
        }
      ]
    }
  ]
}
